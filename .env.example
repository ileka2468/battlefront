# Local workspace startup overrides; values are read by python start.py.
PORT=8088
BF_BIND=127.0.0.1
BF_WORKSPACE=1
BF_WORKSPACE_DB=.battlefront/workspace.sqlite3
BF_WORKSPACE_ACCOUNTS_FILE=.battlefront/accounts.json
# Leave blank for http://127.0.0.1:${PORT} locally.
# BF_WORKSPACE_ORIGIN=
# Optional DCS read-only feeds. Lists are separated by the OS path separator.
# BF_TELEMETRY_FILES=
# BF_CAMPAIGN_FILES=
# BF_REPLAY_FILE=
# Render only: a fixed HTTPS Battlefront origin; set through the dashboard.
# BF_ORIGIN_URL=
