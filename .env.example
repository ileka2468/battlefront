# Local workspace startup overrides; values are read by python start.py.
PORT=8088
BF_BIND=127.0.0.1
BF_WORKSPACE=1
BF_WORKSPACE_DB=.battlefront/workspace.sqlite3
BF_WORKSPACE_ACCOUNTS_FILE=.battlefront/accounts.json
# Leave blank for http://127.0.0.1:${PORT} locally.
# BF_WORKSPACE_ORIGIN=
# Optional DCS read-only feeds. Lists are separated by the OS path separator.
# BF_TELEMETRY_FILES=
# BF_CAMPAIGN_FILES=
# BF_REPLAY_FILE=
# Optional one-recording delivery lane, disabled unless both are set. DCS origin only.
# BF_DCS_DELIVERY_DIR=
# BF_DCS_DELIVERY_ACCOUNT=
# Optional exact mission profile: omit for the Mineralnye Vody demo; set Vaziani for the live campaign.
# BF_DCS_DELIVERY_AIRFIELD=Vaziani
# Optional Vaziani-only BF4 batch adapter; enable only with the matching native bridge installed.
# BF_DCS_DELIVERY_BATCH=1
# Optional self-serve signup and DCS pairing, off unless this owner-only directory exists.
# Install server/BattlefrontAccountLink.lua on the DCS server, then set the Unix path to its pairing spool.
# BF_DCS_LINK_DIR=
# Optional replacement for BF_DCS_DELIVERY_ACCOUNT on a reserved Vaziani demo only:
# BF_DCS_DELIVERY_LINK_PILOT_FILE=
# BF_DCS_LINK_DEMO_MERITS=25
# Render only: a fixed HTTPS Battlefront origin; set through the dashboard.
# BF_ORIGIN_URL=
